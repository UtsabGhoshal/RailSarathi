# ==========================================
# RailSarathi - Environment Variable Template
# Copy this file to `.env` and fill in your secrets
# ==========================================

# TinyFish AI Scraper API Key
# Sign up at https://tinyfish.ai to obtain your API key
TINYFISH_API_KEY=your_tinyfish_api_key_here

# JWT Secret (Base64 encoded 256-bit key)
JWT_SECRET=4a7261696c736172617468695f7365637572655f6a77745f7365637265745f6b65795f32303236
JWT_EXPIRATION=86400000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=railsarathi
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
